---
import type { Projekt } from '../types/project';

interface Props {
  projekt: Projekt;
  activeTab?: 'o-projektu' | 'financije';
}

const { projekt, activeTab = 'o-projektu' } = Astro.props;

const title = `${projekt.naziv} | ${activeTab === 'financije' ? 'Financijski pregled' : 'O projektu'}`;
const description = projekt.opis.slice(0, 160) + '...';
const ogImage = projekt.fotografije?.[0]?.url || projekt.logo_projekta || '/slike/default-og.png';
---

<!DOCTYPE html>
<html lang="hr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={projekt.logo_projekta || '/favicon.svg'} />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 antialiased font-sans">
    <!-- Astroplate Sticky Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/90 border-b border-slate-200/80 shadow-xs">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        
        <!-- Brand / Logo -->
        <a href="/" class="flex items-center gap-3 group transition">
          {projekt.logo_projekta ? (
            <img src={projekt.logo_projekta} alt={projekt.naziv} class="h-9 w-auto object-contain transition-transform group-hover:scale-105" />
          ) : (
            <div class="h-9 w-9 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center font-extrabold text-sm shadow-sm">
              {projekt.naziv.substring(0, 2).toUpperCase()}
            </div>
          )}
          <span class="font-bold text-slate-900 text-base sm:text-lg tracking-tight truncate max-w-[260px] sm:max-w-[420px] group-hover:text-blue-600 transition-colors">
            {projekt.naziv}
          </span>
        </a>

        <!-- Navigation Tabs -->
        <nav class="flex items-center gap-1.5 p-1 bg-slate-100/90 rounded-xl border border-slate-200/80 text-sm font-medium">
          <a
            href="/"
            class:list={[
              'px-4 py-1.5 rounded-lg transition-all duration-200',
              activeTab === 'o-projektu'
                ? 'bg-slate-900 text-white shadow-sm font-semibold'
                : 'text-slate-600 hover:text-slate-900 hover:bg-white/60'
            ]}
          >
            O projektu
          </a>
          <a
            href="/financije"
            class:list={[
              'px-4 py-1.5 rounded-lg transition-all duration-200',
              activeTab === 'financije'
                ? 'bg-slate-900 text-white shadow-sm font-semibold'
                : 'text-slate-600 hover:text-slate-900 hover:bg-white/60'
            ]}
          >
            Financije
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Astroplate Clean Footer -->
    <footer class="border-t border-slate-200 bg-white py-8 text-sm text-slate-500">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="font-semibold text-slate-800">{projekt.naziv}</p>
          <p class="text-xs text-slate-400 mt-0.5">{projekt.vlasnik} &bull; {projekt.lokacija}</p>
        </div>
        <p class="text-xs text-slate-400 text-center sm:text-right">
          &copy; {new Date().getFullYear()} Sva prava pridržana. Sufinancirano iz EU / javnih fondova.
        </p>
      </div>
    </footer>
  </body>
</html>
