---
import type { Projekt } from '../types/project';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  projekt: Projekt;
  activeTab?: 'o-projektu' | 'financije';
}

const { projekt, activeTab = 'o-projektu' } = Astro.props;

const title = `${projekt.naziv} | ${activeTab === 'financije' ? 'Financijski pregled' : 'O projektu'}`;
const description = projekt.opis.slice(0, 160) + '...';
const ogImage = projekt.fotografije?.[0]?.url || projekt.logo_projekta || '/slike/default-og.png';
---

<!DOCTYPE html>
<html lang="hr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Anti-FOUT Theme Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Astroplate Google Fonts (Heebo & Signika) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&family=Signika:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={projekt.logo_projekta || '/favicon.svg'} />
  </head>
  <body class="min-h-screen flex flex-col bg-body text-text dark:bg-darkmode-body dark:text-darkmode-text font-primary antialiased transition-colors duration-200">
    <!-- Astroplate Sticky Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-body/90 dark:bg-darkmode-body/90 border-b border-border dark:border-darkmode-border shadow-xs">
      <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        
        <!-- Brand / Logo -->
        <a href="/" class="flex items-center gap-3.5 group transition">
          {projekt.logo_projekta ? (
            <img src={projekt.logo_projekta} alt={projekt.naziv} class="h-10 w-auto object-contain transition-transform group-hover:scale-105" />
          ) : (
            <div class="h-10 w-10 rounded-md bg-primary dark:bg-darkmode-primary text-body dark:text-darkmode-body flex items-center justify-center font-bold text-sm shadow-xs">
              {projekt.naziv.substring(0, 2).toUpperCase()}
            </div>
          )}
          <span class="font-secondary font-bold text-text-dark dark:text-darkmode-text-dark text-lg sm:text-xl tracking-tight truncate max-w-[220px] sm:max-w-[420px] group-hover:opacity-80 transition-opacity">
            {projekt.naziv}
          </span>
        </a>

        <!-- Right Controls: Nav Tabs & Theme Toggle -->
        <div class="flex items-center gap-3">
          <nav class="flex items-center gap-1.5 p-1 bg-light dark:bg-darkmode-light rounded-lg border border-border dark:border-darkmode-border text-sm font-semibold">
            <a
              href="/"
              class:list={[
                'px-4 py-1.5 rounded transition-all duration-200',
                activeTab === 'o-projektu'
                  ? 'bg-primary text-white dark:bg-darkmode-primary dark:text-darkmode-body shadow-xs font-bold'
                  : 'text-text-dark dark:text-darkmode-text hover:text-primary dark:hover:text-darkmode-primary'
              ]}
            >
              O projektu
            </a>
            <a
              href="/financije"
              class:list={[
                'px-4 py-1.5 rounded transition-all duration-200',
                activeTab === 'financije'
                  ? 'bg-primary text-white dark:bg-darkmode-primary dark:text-darkmode-body shadow-xs font-bold'
                  : 'text-text-dark dark:text-darkmode-text hover:text-primary dark:hover:text-darkmode-primary'
              ]}
            >
              Financije
            </a>
          </nav>

          <!-- Theme Toggle Button -->
          <ThemeToggle />
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-[1240px] w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <slot />
    </main>

    <!-- Astroplate Clean Footer -->
    <footer class="border-t border-border dark:border-darkmode-border bg-light dark:bg-darkmode-light py-8 text-sm text-text-light dark:text-darkmode-text-light">
      <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="font-secondary font-bold text-text-dark dark:text-darkmode-text-dark">{projekt.naziv}</p>
          <p class="text-xs text-text-light dark:text-darkmode-text-light mt-0.5">{projekt.vlasnik} &bull; {projekt.lokacija}</p>
        </div>
        <p class="text-xs text-text-light dark:text-darkmode-text-light text-center sm:text-right">
          &copy; {new Date().getFullYear()} Sva prava pridržana. Sufinancirano iz EU / javnih fondova.
        </p>
      </div>
    </footer>
  </body>
</html>
