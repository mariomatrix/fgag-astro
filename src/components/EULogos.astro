---
import type { EULogo } from '../types/project';

interface Props {
  euLogoi?: EULogo[];
}

const { euLogoi = [] } = Astro.props;
---

{euLogoi.length > 0 && (
  <section class="bg-gradient-to-r from-blue-50/90 via-indigo-50/80 to-slate-50 rounded-2xl border border-blue-200/80 p-6 sm:p-8 mb-10 shadow-xs">
    <div class="flex items-center gap-3 mb-6">
      <span class="text-3xl leading-none">🇪🇺</span>
      <div>
        <h2 class="text-lg font-bold text-slate-900">Podrška Europske unije</h2>
        <p class="text-xs sm:text-sm text-slate-600">Ovaj projekt sufinancira Europska unija iz odgovarajućih fondova i programa.</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      {euLogoi.map((item) => {
        const card = (
          <div class="bg-white rounded-xl border border-blue-200/70 px-4 py-3 flex items-center gap-3 shadow-xs hover:border-blue-300 hover:shadow-sm transition-all">
            <img
              src={item.url}
              alt={item.alt || item.naziv_institucije}
              class="h-10 w-auto max-w-[130px] object-contain"
            />
            <span class="text-xs font-semibold text-slate-800">{item.naziv_institucije}</span>
          </div>
        );

        return item.web ? (
          <a href={item.web} target="_blank" rel="noopener noreferrer" class="no-underline group">
            {card}
          </a>
        ) : (
          card
        );
      })}
    </div>
  </section>
)}
