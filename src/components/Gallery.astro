---
import type { Fotografija } from '../types/project';

interface Props {
  fotografije: Fotografija[];
}

const { fotografije = [] } = Astro.props;
---

<section class="mb-10">
  <h2 class="text-xl font-bold text-slate-900 mb-5 flex items-center gap-2">
    <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
    </svg>
    Galerija Fotografija
  </h2>

  {fotografije.length === 0 ? (
    <p class="text-slate-400 italic text-sm">Nema dostupnih fotografija za ovaj projekt.</p>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {fotografije.map((foto) => (
        <figure class="bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden group hover:shadow-md transition-shadow">
          <div class="relative h-52 w-full bg-slate-100 overflow-hidden">
            <img
              src={foto.url}
              alt={foto.alt}
              loading="lazy"
              class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          {foto.opis && (
            <figcaption class="p-4 text-xs font-medium text-slate-600 bg-slate-50/50 border-t border-slate-100 leading-relaxed">
              {foto.opis}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )}
</section>
