---
import type { Kontakt, Dokument } from '../types/project';

interface Props {
  kontakt: Kontakt;
  dokumenti?: Dokument[];
}

const { kontakt, dokumenti = [] } = Astro.props;
---

<section class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
  <!-- Contact Box -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-xs">
    <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
      <svg class="h-5 w-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
      </svg>
      Službeni Kontakt Projekta
    </h2>

    <div class="space-y-3 text-sm">
      <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 flex flex-col">
        <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">E-pošta</span>
        <a href={`mailto:${kontakt.email}`} class="text-base font-bold text-blue-600 dark:text-blue-400 hover:underline">
          {kontakt.email}
        </a>
      </div>

      <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 flex flex-col">
        <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Telefon</span>
        <a href={`tel:${kontakt.telefon}`} class="text-base font-bold text-slate-900 dark:text-slate-100 hover:text-blue-600 dark:hover:text-blue-400">
          {kontakt.telefon}
        </a>
      </div>
    </div>
  </div>

  <!-- Documents Box -->
  {dokumenti.length > 0 && (
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-xs">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
        <svg class="h-5 w-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
        Službeni Dokumenti
      </h2>

      <ul class="space-y-2.5">
        {dokumenti.map((doc) => (
          <li>
            <a
              href={doc.url}
              class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-800 text-slate-800 dark:text-slate-200 font-medium text-sm hover:bg-blue-50/60 dark:hover:bg-slate-800 hover:border-blue-200 dark:hover:border-slate-700 hover:text-blue-600 dark:hover:text-blue-400 transition-all group"
              download
            >
              <svg class="h-5 w-5 text-blue-600 dark:text-blue-400 shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <span class="truncate">{doc.naziv}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>
