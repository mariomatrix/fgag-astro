---
import type { Financije } from '../types/project';

interface Props {
  financije: Financije;
}

const { financije } = Astro.props;

const formatValuta = (iznos: number, valuta: string = 'EUR') => {
  return new Intl.NumberFormat('hr-HR', {
    style: 'currency',
    currency: valuta,
    maximumFractionDigits: 0
  }).format(iznos);
};

const getStatusBadgeStyle = (status: string) => {
  switch (status.toLowerCase()) {
    case 'odobreno':
    case 'ugovoreno':
    case 'osigurano':
      return 'bg-emerald-50 text-emerald-700 border-emerald-200';
    case 'podnesen zahtjev':
    case 'u pregovorima':
      return 'bg-amber-50 text-amber-700 border-amber-200';
    case 'odbijeno':
      return 'bg-rose-50 text-rose-700 border-rose-200';
    default:
      return 'bg-slate-100 text-slate-700 border-slate-200';
  }
};
---

<section class="space-y-8">
  <!-- Izvori Financiranja Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
    <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
      <svg class="h-5 w-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      Izvori Financiranja (Prihodi)
    </h3>

    <div class="overflow-x-auto rounded-lg border border-slate-100">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider">
          <tr>
            <th class="px-4 py-3">Izvor Financiranja</th>
            <th class="px-4 py-3 text-right">Iznos</th>
            <th class="px-4 py-3">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {(financije.prihodi || []).map((prihod) => (
            <tr class="hover:bg-slate-50/60 transition-colors">
              <td class="px-4 py-3.5 font-medium text-slate-900">{prihod.izvor}</td>
              <td class="px-4 py-3.5 text-right font-bold text-slate-900">{formatValuta(prihod.iznos, financije.valuta)}</td>
              <td class="px-4 py-3.5">
                <span class:list={['inline-block px-2.5 py-1 rounded-full text-xs font-semibold border', getStatusBadgeStyle(prihod.status)]}>
                  {prihod.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Planirani Rashodi Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
    <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
      <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      Planirani Rashodi po Kategorijama
    </h3>

    <div class="overflow-x-auto rounded-lg border border-slate-100">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider">
          <tr>
            <th class="px-4 py-3">Stavka Rashoda</th>
            <th class="px-4 py-3">Kategorija</th>
            <th class="px-4 py-3 text-right">Iznos</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {(financije.rashodi || []).map((rashod) => (
            <tr class="hover:bg-slate-50/60 transition-colors">
              <td class="px-4 py-3.5 font-medium text-slate-900">{rashod.stavka}</td>
              <td class="px-4 py-3.5">
                <span class="inline-block px-2 py-0.5 rounded bg-blue-50 text-blue-700 text-xs font-medium border border-blue-100">
                  {rashod.kategorija}
                </span>
              </td>
              <td class="px-4 py-3.5 text-right font-bold text-slate-900">{formatValuta(rashod.iznos, financije.valuta)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
