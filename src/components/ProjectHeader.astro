---
import type { Projekt } from '../types/project';

interface Props {
  projekt: Projekt;
}

const { projekt } = Astro.props;

const statusBadgeStyles: Record<string, string> = {
  'U izgradnji': 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800',
  'U pripremi': 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800',
  'Završen': 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800',
  'Stagnira': 'bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-950/40 dark:text-rose-300 dark:border-rose-800',
  'Odobren': 'bg-teal-50 text-teal-700 border-teal-200 dark:bg-teal-950/40 dark:text-teal-300 dark:border-teal-800',
  'Podnesen zahtjev': 'bg-yellow-50 text-yellow-800 border-yellow-200 dark:bg-yellow-950/40 dark:text-yellow-300 dark:border-yellow-800'
};

const badgeStyle = statusBadgeStyles[projekt.status] || 'bg-light text-text-dark border-border dark:bg-darkmode-light dark:text-darkmode-text-dark dark:border-darkmode-border';

const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('hr-HR', { month: 'short', year: 'numeric' });
};
---

<section class="bg-body dark:bg-darkmode-body rounded-xl border border-border dark:border-darkmode-border p-6 sm:p-8 shadow-xs mb-8 relative overflow-hidden transition-colors">
  <!-- Accent top line -->
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-primary dark:bg-darkmode-primary"></div>

  <!-- Status Badge -->
  <div class="mb-4 mt-1">
    <span class:list={['inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold border', badgeStyle]}>
      <span class="h-2 w-2 rounded-full bg-current"></span>
      {projekt.status}
    </span>
  </div>

  <!-- Main Hero Block -->
  <div class="flex flex-col sm:flex-row sm:items-start gap-5 mb-6">
    {projekt.logo_projekta && (
      <div class="shrink-0 h-20 w-20 rounded-lg bg-light dark:bg-darkmode-light border border-border dark:border-darkmode-border p-2 flex items-center justify-center">
        <img src={projekt.logo_projekta} alt={`Logo - ${projekt.naziv}`} class="max-h-full max-w-full object-contain" />
      </div>
    )}

    <div class="space-y-1">
      <h1 class="font-secondary text-2xl sm:text-3xl font-extrabold text-text-dark dark:text-darkmode-text-dark tracking-tight leading-snug">
        {projekt.naziv}
      </h1>
      <p class="text-base font-medium text-text-light dark:text-darkmode-text-light">
        Nositelj projekta: <span class="text-text-dark dark:text-darkmode-text-dark font-semibold">{projekt.vlasnik}</span>
      </p>
    </div>
  </div>

  <!-- Meta Chips -->
  <div class="flex flex-wrap gap-2.5 pt-4 border-t border-border dark:border-darkmode-border text-xs font-medium text-text-light dark:text-darkmode-text-light">
    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-light dark:bg-darkmode-light border border-border dark:border-darkmode-border">
      <svg class="h-4 w-4 text-text-dark dark:text-darkmode-text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <span>{projekt.lokacija}</span>
    </div>

    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-light dark:bg-darkmode-light border border-border dark:border-darkmode-border">
      <svg class="h-4 w-4 text-text-dark dark:text-darkmode-text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <span>{formatDate(projekt.pocetak)} &ndash; {formatDate(projekt.zavrsetak)}</span>
    </div>

    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-light dark:bg-darkmode-light border border-border dark:border-darkmode-border">
      <svg class="h-4 w-4 text-text-dark dark:text-darkmode-text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0a2 2 0 01-2-2V5a2 2 0 012-2h4a2 2 0 012 2v14a2 2 0 01-2 2z"></path>
      </svg>
      <span>Poddomena: <code class="text-text-dark dark:text-darkmode-text-dark font-mono font-semibold">{projekt.poddomena}</code></span>
    </div>
  </div>
</section>
